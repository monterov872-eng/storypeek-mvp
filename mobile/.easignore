# Dependencies (installed fresh on EAS)
node_modules/

# Native folders (regenerated by expo prebuild on EAS)
/android/
/ios/

# Expo / Metro caches
.expo/
.expo-shared/
dist/
web-build/

# Environment and secrets
.env
.env.*
!.env.example

# Build artifacts and logs
*.log
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# OS and editor
.DS_Store
Thumbs.db

# Unrelated monorepo directories (not part of the Expo app)
../backend/
../flutter/
../docs/
../legal/
../codemagic.yaml
../package.json
../package-lock.json

# Large or non-essential assets
**/*.mp4
**/*.mov
**/screenshots/**
